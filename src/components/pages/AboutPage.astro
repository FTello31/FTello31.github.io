---
import PageIntro from "@/components/PageIntro.astro";
import { paths, ui } from "@/i18n";
import BaseLayout from "@/layouts/Base.astro";
import type { Locale } from "@/types";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const copy =
	locale === "es"
		? {
				alternate: paths.en.about,
				title: "Ingeniería práctica, comunicación directa y atención al detalle.",
				description:
					"Soy Fernando Tello. Desarrollo software a medida para pymes y acompaño cada proyecto desde la primera conversación hasta la entrega.",
				portraitAlt: "Ilustración de Fernando Tello trabajando con su portátil",
				portraitLabel: "Fernando Tello · Al frente del estudio",
				intro:
					"Un estudio independiente con trato directo: hablas con la persona que diseña y desarrolla tu software.",
				valueTitle: "Qué aporta mi experiencia",
				value:
					"Mi experiencia full stack me permite conectar la interfaz que usa una persona con los sistemas y datos que la hacen posible. Modernizar aplicaciones y coordinar entregas técnicas me ha enseñado a entender los procesos antes de proponer cambios, reducir trabajo manual y cuidar que el software se pueda mantener.",
				backgroundTitle: "Trayectoria seleccionada",
				background:
					"He desarrollado mi carrera profesional en Newfire Global Partners, Globant y Management Solutions. Es experiencia adquirida como empleado, independiente de los proyectos realizados a través del estudio.",
				capabilities: [
					[
						"Mejorar aplicaciones en producción",
						"Revisar calidad, rendimiento y experiencia de uso en sistemas que ya forman parte del trabajo diario.",
					],
					[
						"Modernizar sistemas",
						"Renovar aplicaciones existentes con atención a la continuidad del negocio y a una base de código mantenible.",
					],
					[
						"Automatizar procesos",
						"Conectar datos y operaciones para simplificar tareas repetitivas y reducir trabajo manual.",
					],
				],
				processTitle: "Cómo trabajo",
				processLabel: "PROCESO",
				process: [
					[
						"Entender el problema",
						"Hablamos del proceso actual, de quién lo utiliza y de qué necesita mejorar.",
					],
					[
						"Acordar el alcance",
						"Definimos prioridades, entregables y plazos para trabajar con expectativas claras.",
					],
					[
						"Desarrollar y revisar contigo",
						"Construyo el software y revisamos las entregas para comprobar que responden al problema acordado.",
					],
				],
				contactTitle: "Hablemos del problema que quieres resolver.",
				cases: "Ver casos",
				backgroundLink: "Ver trayectoria completa",
			}
		: {
				alternate: paths.es.about,
				title: "Practical engineering, direct communication and attention to detail.",
				description:
					"I’m Fernando Tello. I build custom software for small and medium-sized businesses and guide each project from the first conversation to delivery.",
				portraitAlt: "Illustration of Fernando Tello working on his laptop",
				portraitLabel: "Fernando Tello · Leading the studio",
				intro:
					"An independent studio with a direct relationship: you talk to the person who designs and builds your software.",
				valueTitle: "What my experience brings",
				value:
					"My full-stack background helps me connect the interface a person uses with the systems and data behind it. Modernising applications and coordinating technical deliveries has taught me to understand processes before proposing changes, reduce manual work and keep software maintainable.",
				backgroundTitle: "Selected background",
				background:
					"I have developed my professional career at Newfire Global Partners, Globant and Management Solutions. This experience comes from employment, separate from projects delivered through the studio.",
				capabilities: [
					[
						"Improve applications in production",
						"Review quality, performance and usability in systems that are already part of everyday work.",
					],
					[
						"Modernise systems",
						"Renew existing applications with attention to business continuity and a maintainable codebase.",
					],
					[
						"Automate processes",
						"Connect data and operations to simplify repetitive tasks and reduce manual work.",
					],
				],
				processTitle: "How I work",
				processLabel: "PROCESS",
				process: [
					[
						"Understand the problem",
						"We discuss the current process, who uses it and what needs to improve.",
					],
					[
						"Agree on the scope",
						"We define priorities, deliverables and timelines to work with clear expectations.",
					],
					[
						"Build and review with you",
						"I build the software and we review deliveries to check that they address the agreed problem.",
					],
				],
				contactTitle: "Let’s talk about the problem you want to solve.",
				cases: "View case studies",
				backgroundLink: "View full professional background",
			};
---

<BaseLayout meta={{ alternateUrl: copy.alternate, description: copy.description, locale, title: t.about }}>
	<PageIntro code={t.about.toUpperCase()} description={copy.description} title={copy.title} />
	<section class="about-grid about-studio">
		<div class="about-profile">
			<p>{copy.intro}</p>
			<figure>
				<img alt={copy.portraitAlt} height="1024" loading="lazy" src="/fernando-tello.png" width="1024" />
				<figcaption>{copy.portraitLabel}</figcaption>
			</figure>
		</div>
		<div>
			<h2>{copy.valueTitle}</h2>
			<p>{copy.value}</p>
		</div>
	</section>
	<section class="site-section about-studio">
		<h2 class="subsection-heading">{copy.backgroundTitle}</h2>
		<p class="section-summary">{copy.background}</p>
		<div class="services-grid">
			{copy.capabilities.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}
		</div>
	</section>
	<section class="process-section commercial-process about-studio">
		<div><span class="commercial-process__label">{copy.processLabel}</span><h2>{copy.processTitle}</h2></div>
		<ol>
			{copy.process.map(([title, body], index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{title}</strong><p>{body}</p></div></li>)}
		</ol>
	</section>
	<section class="closing-cta closing-cta--compact">
		<h2>{copy.contactTitle}</h2>
		<div class="closing-cta__actions">
			<a class="button-primary" href={paths[locale].contact}>{t.discussProject}</a>
			<a class="text-link" href={paths[locale].cases}>{copy.cases}</a>
			<a class="text-link" href={`${paths[locale].profile}#experience`}>{copy.backgroundLink}</a>
		</div>
	</section>
</BaseLayout>

<style>
	.about-studio p {
		font-size: 1rem;
	}
	.about-studio figcaption {
		font-size: 0.875rem;
	}
	.about-studio .services-grid {
		margin-top: 32px;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
	}
</style>
