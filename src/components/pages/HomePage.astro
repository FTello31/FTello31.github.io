---
import CaseStudyPreview from "@/components/CaseStudyPreview.astro";
import InquiryForm from "@/components/InquiryForm.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import WhatsAppLink from "@/components/WhatsAppLink.astro";
import { getCaseStudies } from "@/data/content";
import { services } from "@/data/services";
import { paths, ui } from "@/i18n";
import BaseLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";
import type { Locale } from "@/types";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const caseStudies = await getCaseStudies(locale);
const featuredCase = caseStudies.find((caseStudy) => caseStudy.data.featured);

const copy =
	locale === "es"
		? {
				about:
					"Estudio independiente dirigido por Fernando: hablas directamente con quien diseña y desarrolla.",
				aboutDescription:
					"Más de seis años construyendo software y mejorando sistemas en producción. Combino visión de producto, desarrollo full stack y una comunicación directa para reducir riesgo y dejar una base mantenible.",
				allCases: "Ver Luna y Junio y Plannick",
				alternate: paths.en.home,
				caseDescription:
					"El primer caso comercial se publicará cuando el cliente haya autorizado el contexto, las imágenes y al menos un resultado.",
				casePending: "Caso real en preparación",
				caseSection: "Caso destacado",
				contactDescription: `Comparte el contexto, el presupuesto orientativo y el plazo. Te responderé personalmente en ${siteConfig.contact.responseTime.es} para decidir si tiene sentido avanzar.`,
				contactTitle: "¿Qué proceso necesita moverse mejor?",
				description:
					"Diseño y construyo automatizaciones, herramientas internas y aplicaciones web para pymes que necesitan operar mejor sin ampliar su equipo técnico.",
				faq: [
					[
						"¿Quién es propietario del código?",
						"El cliente recibe la propiedad del código creado para el proyecto una vez completados los pagos, salvo componentes de terceros y acuerdos específicos.",
					],
					[
						"¿Incluyes mantenimiento?",
						"La entrega incluye documentación y un periodo de estabilización acordado. El mantenimiento posterior puede contratarse por alcance o como colaboración recurrente.",
					],
					[
						"¿Cuánto tarda un proyecto?",
						"Una automatización acotada suele requerir entre 3 y 8 semanas; una herramienta o aplicación completa, entre 6 y 16. El alcance definitivo marca el calendario.",
					],
					[
						"¿Puedes trabajar con nuestros sistemas actuales?",
						"Sí. El diagnóstico inicial revisa APIs, datos, seguridad y limitaciones antes de comprometer una integración.",
					],
					[
						"¿Trabajas en remoto?",
						"Sí. Trabajo desde España con equipos en remoto y puedo coordinar reuniones en español o inglés.",
					],
					[
						"¿Por qué el presupuesto no tiene precio fijo?",
						"Cada proyecto parte de un problema distinto. El presupuesto se define cuando entendemos el alcance, no antes. El primer paso es una conversación sin compromiso.",
					],
				],
				faqTitle: "Preguntas antes de empezar",
				heroLabel: "Estudio independiente de software · España / remoto",
				heroTitle: "Menos trabajo manual. Más negocio en movimiento.",
				microcopy: `Respuesta en ${siteConfig.contact.responseTime.es} · Proceso claro · ES / EN`,
				process: [
					[
						"Diagnóstico",
						"Entendemos el proceso actual, la fricción y el resultado que merece la pena conseguir.",
					],
					[
						"Alcance",
						"Definimos una primera entrega verificable, sus límites, calendario y presupuesto.",
					],
					[
						"Construcción",
						"Diseño, desarrollo y validación por iteraciones cortas con decisiones visibles.",
					],
					[
						"Entrega",
						"Despliegue, documentación, traspaso y un siguiente paso basado en lo aprendido.",
					],
				],
				processTitle: "Un proceso claro, de la fricción a la entrega",
				proof: [
					["6+ años", "Software en producción"],
					["Web · automatización · IA", "Capacidades aplicadas al problema"],
					["Trato directo", "Diseño y desarrollo con Fernando"],
				],
				proofLine: "6+ años de experiencia · Web, automatización e IA aplicada",
				secondaryCase: featuredCase ? "Ver un caso real" : "Cómo documento los casos",
				servicesDescription:
					"Ofertas concretas para problemas frecuentes, con flexibilidad cuando el proyecto necesita un alcance a medida.",
				servicesTitle: "Problemas que puedo ayudarte a resolver",
			}
		: {
				about:
					"An independent studio run by Fernando: you speak directly with the person who designs and builds.",
				aboutDescription:
					"More than six years building software and improving production systems. I combine product thinking, full-stack development and direct communication to reduce risk and leave a maintainable foundation.",
				allCases: "See Luna y Junio and Plannick",
				alternate: paths.es.home,
				caseDescription:
					"The first commercial case study will be published once the client has authorised the context, imagery and at least one outcome.",
				casePending: "Real case study in preparation",
				caseSection: "Featured case",
				contactDescription: `Share the context, indicative budget and timeline. I will reply personally within ${siteConfig.contact.responseTime.en} so we can decide whether it makes sense to move forward.`,
				contactTitle: "Which process needs to move better?",
				description:
					"I design and build automation, internal tools and web applications for SMEs that need to operate better without expanding their technical team.",
				faq: [
					[
						"Who owns the code?",
						"The client owns the code created for the project once payments are complete, except for third-party components and any specific agreement.",
					],
					[
						"Do you provide maintenance?",
						"Delivery includes documentation and an agreed stabilisation period. Ongoing maintenance can be scoped separately or arranged as a recurring collaboration.",
					],
					[
						"How long does a project take?",
						"A focused automation typically takes 3–8 weeks; a complete tool or application, 6–16. The final scope determines the schedule.",
					],
					[
						"Can you work with our existing systems?",
						"Yes. The initial assessment reviews APIs, data, security and constraints before committing to an integration.",
					],
					[
						"Do you work remotely?",
						"Yes. I work from Spain with remote teams and can coordinate meetings in English or Spanish.",
					],
					[
						"How does pricing work?",
						"Every project starts from a different problem. The budget is defined once we understand the scope, not before. The first step is a no-commitment conversation.",
					],
				],
				faqTitle: "Questions before we start",
				heroLabel: "Independent software studio · Spain / remote",
				heroTitle: "Less manual work. More business in motion.",
				microcopy: `Reply within ${siteConfig.contact.responseTime.en} · Clear process · ES / EN`,
				process: [
					[
						"Assessment",
						"We understand the current process, the friction and the outcome worth pursuing.",
					],
					["Scope", "We define a verifiable first delivery, its boundaries, schedule and budget."],
					[
						"Build",
						"Design, development and validation in short iterations with visible decisions.",
					],
					[
						"Handover",
						"Deployment, documentation, handover and a next step grounded in what we learned.",
					],
				],
				processTitle: "A clear process, from friction to delivery",
				proof: [
					["6+ years", "Production software"],
					["Web · automation · IA", "Capabilities applied to the problem"],
					["Direct contact", "Design and development with Fernando"],
				],
				proofLine: "6+ years of experience · Web, automation and applied AI",
				secondaryCase: featuredCase ? "See a real case" : "How I document case studies",
				servicesDescription:
					"Concrete offers for recurring problems, with flexibility when the project needs a bespoke scope.",
				servicesTitle: "Problems I can help you solve",
			};
---

<BaseLayout meta={{ alternateUrl: copy.alternate, description: copy.description, locale, title: siteConfig.title }}>
	<section class="commercial-hero">
		<div class="commercial-hero__content">
			<p class="commercial-hero__label">{copy.heroLabel}</p>
			<h1>{copy.heroTitle}</h1>
			<p class="commercial-hero__lead">{copy.description}</p>
			<div class="commercial-hero__actions">
				<a class="button-primary" data-umami-event="Hero Contact Click" href="#contact">{t.discussProject} →</a>
				<a class="button-secondary" data-umami-event={featuredCase ? "Case Study View" : undefined} href={featuredCase ? `#featured-case` : paths[locale].cases}>{copy.secondaryCase} →</a>
			</div>
			<p class="commercial-hero__microcopy">{copy.microcopy}</p>
			<p class="commercial-hero__proof">{copy.proofLine}</p>
		</div>
		<div class="commercial-hero__graphic" aria-hidden="true"><span>FTS</span><small>FIG_001 / OPERATIONS</small></div>
	</section>

	<section class="proof-strip" aria-label={locale === "es" ? "Prueba y experiencia" : "Proof and experience"}>
		{copy.proof.map(([value, label]) => <p><strong>{value}</strong><span>{label}</span></p>)}
	</section>

	<section class="site-section" id="featured-case">
		<SectionHeading count={featuredCase ? "01" : "—"} index="01" title={copy.caseSection} />
		{featuredCase
			? <CaseStudyPreview caseStudy={featuredCase} featured locale={locale} />
			: <div class="case-pending"><span>CASE_001 / PENDING_APPROVAL</span><h3>{copy.casePending}</h3><p>{copy.caseDescription}</p><a class="section-link" href={paths[locale].cases}>{copy.secondaryCase} →</a></div>}
		{featuredCase && caseStudies.length > 1 && <a class="section-link" href={paths[locale].cases}>{copy.allCases} →</a>}
	</section>

	<section class="site-section">
		<SectionHeading count={services[locale].length} index="02" title={copy.servicesTitle} />
		<p class="section-summary">{copy.servicesDescription}</p>
		<div class="services-grid">
			{
				services[locale].map((service, index) => (
					<article>
						<span>{String(index + 1).padStart(2, "0")} / {service.code}</span>
						<h3>{service.title}</h3>
						<p>{service.idealFor}</p>
						<a href={`${paths[locale].services}#${service.code.toLowerCase()}`}>
							{locale === "es" ? "Ver servicio" : "View service"} &rarr;
						</a>
					</article>
				))
			}
		</div>
	</section>

	<section class="process-section commercial-process">
		<div><span>03 / {locale === "es" ? "PROCESO" : "PROCESS"}</span><h2>{copy.processTitle}</h2><a class="section-link" href={paths[locale].services}>{locale === "es" ? "Conocer el proceso" : "See the process"} →</a></div>
		<ol>{copy.process.map(([title, body], index) => <li><span>0{index + 1}</span><div><strong>{title}</strong><p>{body}</p></div></li>)}</ol>
	</section>

	<section class="about-commercial">
		<div><span>04 / {locale === "es" ? "ESTUDIO" : "STUDIO"}</span><h2>{copy.about}</h2><p>{copy.aboutDescription}</p><a class="button-secondary" href={paths[locale].about}>{locale === "es" ? "Sobre Fernando" : "About Fernando"} →</a></div>
		<div class="about-commercial__facts"><p><strong>6+</strong><span>{locale === "es" ? "años de experiencia" : "years of experience"}</span></p><p><strong>{locale === "es" ? "España" : "Spain"}</strong><span>{locale === "es" ? "trabajo remoto" : "remote work"}</span></p><p><strong>ES / EN</strong><span>{locale === "es" ? "comunicación directa" : "direct communication"}</span></p></div>
	</section>

	<section class="faq-section site-section">
		<SectionHeading count={copy.faq.length} index="05" title={copy.faqTitle} />
		<div class="faq-list">{copy.faq.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
	</section>

	<section class="home-contact" id="contact">
		<div class="home-contact__intro"><span>06 / {locale === "es" ? "CONTACTO" : "CONTACT"}</span><h2>{copy.contactTitle}</h2><p>{copy.contactDescription}</p><div class="contact-channels"><a class="text-link" href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a><WhatsAppLink label={t.whatsapp} locale={locale} /></div></div>
		<InquiryForm locale={locale} />
	</section>
</BaseLayout>
