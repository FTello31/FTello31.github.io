---
import { type CollectionEntry, render } from "astro:content";
import { entrySlug, paths } from "@/i18n";
import type { Locale } from "@/types";

interface Props {
	locale: Locale;
	note: CollectionEntry<"note">;
	preview?: boolean;
}

const { locale, note, preview = false } = Astro.props;
const { Content } = await render(note);
---

<article class:list={["note-card", preview && "note-card--preview"]} data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
	<time datetime={note.data.publishDate.toISOString()}>{note.data.publishDate.toLocaleDateString(locale, { day: "2-digit", month: "2-digit", year: "numeric" })}</time>
	<h2>{preview ? <a href={`${paths[locale].notes}${entrySlug(note.id)}/`}>{note.data.title}</a> : note.data.title}</h2>
	{note.data.description && <p class="note-card__description">{note.data.description}</p>}
	{!preview && <div class="prose"><Content /></div>}
</article>
