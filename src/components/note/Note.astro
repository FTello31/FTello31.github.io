---
import { type CollectionEntry, render } from "astro:content";
import type { Locale } from "@/types";

interface Props {
	locale: Locale;
	note: CollectionEntry<"note"> | CollectionEntry<"notionNote">;
	preview?: boolean;
}

const { locale, note, preview = false } = Astro.props;
const externalUrl = "externalUrl" in note.data ? note.data.externalUrl : undefined;
const href = externalUrl ?? `/notes/${note.id}/`;
const Content = !preview && !externalUrl ? (await render(note)).Content : undefined;
---

<article class:list={["note-card", preview && "note-card--preview"]} data-pagefind-body>
	<time datetime={note.data.publishDate.toISOString()}
		>{
			note.data.publishDate.toLocaleDateString(locale, {
				day: "2-digit",
				month: "2-digit",
				year: "numeric",
			})
		}</time
	>
	{
		preview ? (
			<h3>
				<a href={href} rel={externalUrl ? "noreferrer noopener" : undefined} target={externalUrl ? "_blank" : undefined}>
					{note.data.title}
				</a>
			</h3>
		) : (
			<h1>{note.data.title}</h1>
		)
	}
	{note.data.description && <p class="note-card__description">{note.data.description}</p>}
	{
		Content && (
			<div class="prose">
				<Content />
			</div>
		)
	}
</article>
