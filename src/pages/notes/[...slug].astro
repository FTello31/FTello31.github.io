---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import Note from "@/components/note/Note.astro";
import { getCourseNotes, getCourses, getNotes } from "@/data/content";
import BaseLayout from "@/layouts/Base.astro";

type Props =
	| { entry: CollectionEntry<"course">; type: "course" }
	| {
			course?: CollectionEntry<"course">;
			entry: CollectionEntry<"note"> | CollectionEntry<"notionNote">;
			type: "note";
	  };

export const getStaticPaths = (async () => {
	const [courses, notes] = await Promise.all([getCourses(), getNotes()]);
	const coursesById = new Map(courses.map((course) => [course.id, course]));
	return [
		...courses.map((entry) => ({
			params: { slug: entry.id },
			props: { entry, type: "course" as const },
		})),
		...notes
			.filter((entry) => !("externalUrl" in entry.data))
			.map((entry) => {
				const course =
					"course" in entry.data && entry.data.course
						? coursesById.get(entry.data.course.id)
						: undefined;
				return {
					params: { slug: entry.id },
					props: { entry, type: "note" as const, ...(course && { course }) },
				};
			}),
	];
}) satisfies GetStaticPaths;

const props = Astro.props as Props;
const { entry, type } = props;
const course = type === "note" ? props.course : undefined;
const lessons = type === "course" ? await getCourseNotes(entry.id) : [];
---

<BaseLayout
	meta={{
		description: entry.data.description,
		locale: "en",
		shared: true,
		title: entry.data.title,
	}}
>
	<section class="article-shell">
		<nav aria-label="Breadcrumb" class="note-breadcrumb">
			<ol>
				<li><a href="/bitacora/">Bitácora</a></li>
				{course && <li><a href={`/notes/${course.id}/`}>{course.data.title}</a></li>}
				<li aria-current="page">{entry.data.title}</li>
			</ol>
		</nav>
		{
			type === "course" ? (
				<>
					<header>
						<>
							<h1>{entry.data.title}</h1>
							<p>{entry.data.description}</p>
						</>
					</header>
					<section>
						<h2>Lessons</h2>
						<div class="notes-list">
							{lessons.map((lesson) => (
								<article class="note-card note-card--preview">
									<span>Lesson {lesson.data.order}</span>
									<h3>
										<a
											href={"externalUrl" in lesson.data ? lesson.data.externalUrl : `/notes/${lesson.id}/`}
											rel={"externalUrl" in lesson.data ? "noreferrer noopener" : undefined}
											target={"externalUrl" in lesson.data ? "_blank" : undefined}
										>
											{lesson.data.title}
										</a>
									</h3>
									{lesson.data.description && (
										<p class="note-card__description">{lesson.data.description}</p>
									)}
								</article>
							))}
						</div>
					</section>
				</>
			) : (
				<Note locale="en" note={entry} />
			)
		}
	</section>
</BaseLayout>
