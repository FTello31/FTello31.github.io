---
import PageIntro from "@/components/PageIntro.astro";
import { getCourses, getStandaloneNotes } from "@/data/content";
import BaseLayout from "@/layouts/Base.astro";

const [courses, notes] = await Promise.all([getCourses(), getStandaloneNotes()]);
---

<BaseLayout meta={{ description: "Course notes, experiments and technical shortcuts shared in public.", locale: "en", shared: true, title: "Notes" }}>
	<PageIntro code={`NOTES / ${String(courses.length + notes.length).padStart(2, "0")}`} description="Course notes, experiments and technical shortcuts shared in public." title="Useful ideas before they need to become a full article." />
	{courses.length > 0 && <section class="notes-list">
		<h2>Courses</h2>
		{courses.map((course) => <article class="note-card note-card--preview"><h3><a href={`/notes/${course.id}/`}>{course.data.title}</a></h3><p class="note-card__description">{course.data.description}</p></article>)}
	</section>}
	{notes.length > 0 && <section class="notes-list">
		<h2>Notes</h2>
		{notes.map((note) => <article class="note-card note-card--preview"><time datetime={note.data.publishDate.toISOString()}>{note.data.publishDate.toLocaleDateString("en", { day: "2-digit", month: "2-digit", year: "numeric" })}</time><h3><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3>{note.data.description && <p class="note-card__description">{note.data.description}</p>}</article>)}
	</section>}
</BaseLayout>
