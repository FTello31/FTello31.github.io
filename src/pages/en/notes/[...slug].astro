---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Note from "@/components/note/Note.astro";
import { getNotes } from "@/data/content";
import { entrySlug, paths } from "@/i18n";
import BaseLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async () => {
	const [notes, translations] = await Promise.all([getNotes("en"), getNotes("es")]);
	return notes.map((note) => {
		const translation = translations.find(
			(candidate) => candidate.data.translationKey === note.data.translationKey,
		);
		return {
			params: { slug: entrySlug(note.id) },
			props: {
				alternateUrl: translation
					? `${paths.es.notes}${entrySlug(translation.id)}/`
					: paths.es.notes,
				note,
			},
		};
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { alternateUrl, note } = Astro.props;
---
<BaseLayout meta={{ alternateUrl, description: note.data.description, locale: "en", title: note.data.title }}><section class="article-shell"><Note locale="en" note={note} /></section></BaseLayout>
